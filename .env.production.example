# F1 Frontend - Production Environment Variables
# Copy this file to .env.production and update with your actual values
# DO NOT commit .env.production to version control!

# Clerk Authentication
# Get these from: https://dashboard.clerk.com/ -> Your App -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_publishable_key_here

# API Configuration
VITE_API_BASE_URL=/api

# Clerk URLs (adjust to your domain if using custom URLs)
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
